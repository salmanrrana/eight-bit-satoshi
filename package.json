{
  "name": "8bit-satoshi",
  "version": "1.3.0",
  "private": true,
  "scripts": {
    "prepare": "node tools/install-hooks.mjs",
    "check:staged": "node tools/check-staged.mjs",
    "start": "python3 -m http.server 5000 --bind 127.0.0.1",
    "start:service": "systemctl --user stop 8bit-satoshi >/dev/null 2>&1 || true; systemd-run --user --unit=8bit-satoshi --collect --working-directory=$PWD python3 -m http.server 5000 --bind 127.0.0.1",
    "stop": "systemctl --user stop 8bit-satoshi",
    "lint": "eslint js tests tools eslint.config.mjs",
    "format:check": "prettier --check package.json eslint.config.mjs tools/*.mjs",
    "check": "npm run check:fast",
    "check:fast": "npm run lint && npm run format:check && npm test",
    "test": "node --test tests/*.test.js"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "prettier": "^3.8.2"
  }
}
